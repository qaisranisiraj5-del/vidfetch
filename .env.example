# ============================================================================
# Social Video Downloader — environment template
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# --- Supabase (required) ---
# Find these in your Supabase project dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- First administrator account (used ONLY by scripts/create-admin.mjs) ---
# These are read from the environment at runtime by the seed script.
# They are NOT used by the application itself and must NOT be committed.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# --- Rate limiting / site behaviour (optional, sane defaults in code) ---
RATE_LIMIT_PER_HOUR=20
CONTACT_EMAIL=support@example.com

# --- Platform integrations (all optional) ---
# When any of these are absent, the matching integration reports
# "not configured" honestly and the UI shows that state.
# YouTube Data API v3 key (metadata lookup only; no download API exists)
YOUTUBE_API_KEY=
# Instagram (Meta) — requires a Meta developer app + user-authorized token
INSTAGRAM_ACCESS_TOKEN=
# Facebook (Meta) — app credentials for Graph API video access
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# TikTok — developer app credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
